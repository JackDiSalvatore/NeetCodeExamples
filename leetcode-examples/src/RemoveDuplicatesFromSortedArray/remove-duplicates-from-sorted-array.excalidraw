    {
      "id": "TH4RHlP7t8_f-jwKhocQd",
      "type": "text",
      "x": 1261.3614690634768,
      "y": 2805.9710089563255,
      "width": 439.91966992616653,
      "height": 1620,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bJ5",
      "roundness": null,
      "seed": 1697693304,
      "version": 2069,
      "versionNonce": 1015072015,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1732106750455,
      "link": null,
      "locked": false,
      "text": "NOTE: The \"first\" (second) index should\n// index to place number if it is unique (not duplicate)\n// index should hold the last unique element in our array\n//     (which will be the LENGTH of our new array)\nindex = 1;\n\n\n// Go through all the number\n// if they are not the same, we will place the adjacent number\n// at our index\n\n\n\n\nfor (i=0; i < nums.length - 1; i++)\n    if( nums[i] != nums[i+1])\n        // not duplicate!\n        // place the current number in the index we are on\n\n\n\n\n\n\n\n\n\n\n        nums[index++] = nums[i + 1]\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n// next iteration\n    if( nums[i] != nums[i+1])\n        // not duplicates\n        nums[index++] = nums[i+1]\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n// next iteration\n    if (nums[i] != nums[i+1])\n        // they are duplicates\n        // skip this\n\n\n\nnums = [1, 2, 3, 3]\nindex = 3\n\nreturn index; // 3 is the number of UNIQUE elements",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NOTE: The \"first\" (second) index should\n// index to place number if it is unique (not duplicate)\n// index should hold the last unique element in our array\n//     (which will be the LENGTH of our new array)\nindex = 1;\n\n\n// Go through all the number\n// if they are not the same, we will place the adjacent number\n// at our index\n\n\n\n\nfor (i=0; i < nums.length - 1; i++)\n    if( nums[i] != nums[i+1])\n        // not duplicate!\n        // place the current number in the index we are on\n\n\n\n\n\n\n\n\n\n\n        nums[index++] = nums[i + 1]\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n// next iteration\n    if( nums[i] != nums[i+1])\n        // not duplicates\n        nums[index++] = nums[i+1]\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n// next iteration\n    if (nums[i] != nums[i+1])\n        // they are duplicates\n        // skip this\n\n\n\nnums = [1, 2, 3, 3]\nindex = 3\n\nreturn index; // 3 is the number of UNIQUE elements",
      "autoResize": true,
      "lineHeight": 1.35
    },
