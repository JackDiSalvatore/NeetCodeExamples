    {
      "id": "_sJW-lUwqx0l9OPhJAzpr",
      "type": "text",
      "x": 2231.089940974496,
      "y": 4133.6583186729895,
      "width": 77.69593811035156,
      "height": 21.6,
      "angle": 0,
      "strokeColor": "#1e1e1e",
