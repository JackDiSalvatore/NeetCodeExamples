      "index": "bIv",
      "roundness": null,
      "seed": 773062776,
      "version": 68,
      "versionNonce": 100220424,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1731789833059,
      "link": null,
      "locked": false,
      "text": "* Given an integer array nums sorted in non-decreasing order,\n* remove the duplicates in-place such that each unique element appears only once.\n* The relative order of the elements should be kept the same.\n* Then return the number of unique elements in nums.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Given an integer array nums sorted in non-decreasing order,\n* remove the duplicates in-place such that each unique element appears only once.\n* The relative order of the elements should be kept the same.\n* Then return the number of unique elements in nums.",
      "autoResize": true,
      "lineHeight": 1.35
    },
