    },
    {
      "id": "UQzsNktUsdBqZEnQ8ws9Q",
      "type": "text",
      "x": 3083.1210113790503,
      "y": 2822.5958775251966,
      "width": 439.91966992616653,
      "height": 1857.6000000000001,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOm",
      "roundness": null,
      "seed": 698292911,
      "version": 3288,
      "versionNonce": 1243687105,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1732109304082,
      "link": null,
      "locked": false,
      "text": "NOTE: The \"first\" (second) index should\n// index to place number if it is unique (not duplicate)\n// index should hold the last unique element in our array\n//     (which will be the LENGTH of our new array)\n\nunqiueIndex = 1;    // index of last unique number\n\n\n// Go through all the number\n// if they are not the same, we will place the adjacent number\n// at our index\n\n\n\n\nfor (i=0; i < nums.length - 1; i++)\n\n    if( nums[i] != nums[i + 1])\n        // NOT DUPLICATE\n        // place the next element (i+1) into our index\n\n        nums[unqiueIndex] = nums[i + 1];    // 2\n\n        // increase our unqiueIndex\n        unqiueIndex = unqiueIndex + 1   //  1 + 1 = 2\n        \n\n\n\n\n\n\n\n\n\n\n\n\n\nNEXT ITERATION\n    i = 1\n    nums.length - 1 = 3\n\nif ( nums[i] != nums[i + 1] )\n    // DUPLICATED FOUND: do nothing!\n\n\n\n\n\n\n\n\n\n\n\n\nNEXT ITERATION\n    i = 2\n    nums.length - 1 = 3\n\nif ( nums[i] != nums[i + 1] )\n    // NOT DUPLICATE\n    nums[uniqueIndex] = nums[i + 1];    // 3\n    uniqueIndex = uniqueIndex + 1;       // 3\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nNEXT ITERATION\n    i - 3\n    num.length -1 = 3\n\nSTOP FOR LOOP\n\n    return uniqueIndex;    // 3",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NOTE: The \"first\" (second) index should\n// index to place number if it is unique (not duplicate)\n// index should hold the last unique element in our array\n//     (which will be the LENGTH of our new array)\n\nunqiueIndex = 1;    // index of last unique number\n\n\n// Go through all the number\n// if they are not the same, we will place the adjacent number\n// at our index\n\n\n\n\nfor (i=0; i < nums.length - 1; i++)\n\n    if( nums[i] != nums[i + 1])\n        // NOT DUPLICATE\n        // place the next element (i+1) into our index\n\n        nums[unqiueIndex] = nums[i + 1];    // 2\n\n        // increase our unqiueIndex\n        unqiueIndex = unqiueIndex + 1   //  1 + 1 = 2\n        \n\n\n\n\n\n\n\n\n\n\n\n\n\nNEXT ITERATION\n    i = 1\n    nums.length - 1 = 3\n\nif ( nums[i] != nums[i + 1] )\n    // DUPLICATED FOUND: do nothing!\n\n\n\n\n\n\n\n\n\n\n\n\nNEXT ITERATION\n    i = 2\n    nums.length - 1 = 3\n\nif ( nums[i] != nums[i + 1] )\n    // NOT DUPLICATE\n    nums[uniqueIndex] = nums[i + 1];    // 3\n    uniqueIndex = uniqueIndex + 1;       // 3\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nNEXT ITERATION\n    i - 3\n    num.length -1 = 3\n\nSTOP FOR LOOP\n\n    return uniqueIndex;    // 3",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "5Btm7MdltdxR2l0ZadhJQ",
