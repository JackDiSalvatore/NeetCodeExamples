    {
      "id": "z0DGlSW2Z0lfCP59MHDJz",
      "type": "text",
      "x": 1312.5138908032338,
      "y": 2588.3709289143317,
      "width": 597.8714599609375,
      "height": 86.4,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
