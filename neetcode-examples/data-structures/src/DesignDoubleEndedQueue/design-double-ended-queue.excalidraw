    {
      "id": "3LfaIG77aygXIiACGeEdo",
      "type": "text",
      "x": 350.57335601726993,
      "y": -260.1273653174702,
      "width": 651.5993955135345,
      "height": 151.20000000000002,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3C",
      "roundness": null,
      "seed": 1808096718,
      "version": 593,
      "versionNonce": 1674812174,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1731262783181,
      "link": null,
      "locked": false,
      "text": "First In, First Out\nusing a linked list we can achieve the following time metrics\nO(1) instead of O(n) because we will not need to shift all the elements after removing one,\nunlike a dynamic array.\n\nEnqueue (add item into list): O(1)\nDequeue (remove item from front of list): O(1)",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "First In, First Out\nusing a linked list we can achieve the following time metrics\nO(1) instead of O(n) because we will not need to shift all the elements after removing one,\nunlike a dynamic array.\n\nEnqueue (add item into list): O(1)\nDequeue (remove item from front of list): O(1)",
      "autoResize": true,
      "lineHeight": 1.35
    },
