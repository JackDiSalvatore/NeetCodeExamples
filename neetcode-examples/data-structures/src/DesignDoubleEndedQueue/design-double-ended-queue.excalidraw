      "link": null,
      "locked": false,
      "text": "IF queue is empty\n\n\nif (dummyTail.prev == null)\n\n\n\n\n\n\n\n\n\n\n\n    // Attach newNode to dummyHead\n    dummyHead.next = newNode\n    newNode.prev = dummyHead\n\n\n\n\n\n\n\n\n\n\n\n\n    // Attach dummyTail to newNode\n    newNode.next = dummyTail\n    dummyTail.prev = newNode",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "IF queue is empty\n\n\nif (dummyTail.prev == null)\n\n\n\n\n\n\n\n\n\n\n\n    // Attach newNode to dummyHead\n    dummyHead.next = newNode\n    newNode.prev = dummyHead\n\n\n\n\n\n\n\n\n\n\n\n\n    // Attach dummyTail to newNode\n    newNode.next = dummyTail\n    dummyTail.prev = newNode",
      "autoResize": true,
      "lineHeight": 1.35
    },
