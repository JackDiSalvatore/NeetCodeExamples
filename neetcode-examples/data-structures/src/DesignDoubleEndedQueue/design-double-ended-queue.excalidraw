      "isDeleted": false,
      "boundElements": [],
      "updated": 1731272215125,
      "link": null,
      "locked": false,
      "text": "returnNode = dummyHead.next\nafter = returnNode.next\n\n\n\n\n\n\n\n\n\n// Attach dummyHead to after\ndummyHead.next = after\nafter.prev = dummyHead\n\n\n\n\n\n\n\n\n\n\nif (after == dummyTail)\n   // detach dummyHead\n    dummyHead.next = null\n    // detach tail\n    dummyTail.prev = null\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nreturn returnNode",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "returnNode = dummyHead.next\nafter = returnNode.next\n\n\n\n\n\n\n\n\n\n// Attach dummyHead to after\ndummyHead.next = after\nafter.prev = dummyHead\n\n\n\n\n\n\n\n\n\n\nif (after == dummyTail)\n   // detach dummyHead\n    dummyHead.next = null\n    // detach tail\n    dummyTail.prev = null\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nreturn returnNode",
      "autoResize": true,
      "lineHeight": 1.35
