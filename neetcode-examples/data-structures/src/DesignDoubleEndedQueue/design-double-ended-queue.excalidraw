      "text": "IF queue is empty\n\n\nif (dummyHead.next == null || dummyTail.prev == null)\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n// Attach newNode after the dummyHead\ndummyHead.next = newNode\nnewNode.prev = dummyHead\n\n// Attach dummyTail\nnewNode.next = dummyTail\ndummyTail.prev = newNode\n",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "IF queue is empty\n\n\nif (dummyHead.next == null || dummyTail.prev == null)\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n// Attach newNode after the dummyHead\ndummyHead.next = newNode\nnewNode.prev = dummyHead\n\n// Attach dummyTail\nnewNode.next = dummyTail\ndummyTail.prev = newNode\n",
      "autoResize": true,
      "lineHeight": 1.35
    },
