      "link": null,
      "locked": false,
      "text": "* find index to remove *\n* we will keep track of the \"previous\" node to the target being removed *\n",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* find index to remove *\n* we will keep track of the \"previous\" node to the target being removed *\n",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "UPerOsznFFfFwSstZMFdH",
      "type": "text",
      "x": 1585.7976484374558,
      "y": 1776.5613709982931,
      "width": 434.0316162109375,
      "height": 216,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1q",
      "roundness": null,
      "seed": 1406550943,
      "version": 330,
      "versionNonce": 301038943,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1730723343958,
      "link": null,
      "locked": false,
      "text": "prev = head\ni = 0\n\nwhile (prev != null && i < index)\n    i++\n    prev = prev.next   // continue on\n\n* at this point previous is right behind the target to remove *\n\n",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "prev = head\ni = 0\n\nwhile (prev != null && i < index)\n    i++\n    prev = prev.next   // continue on\n\n* at this point previous is right behind the target to remove *\n\n",
      "autoResize": true,
      "lineHeight": 1.35
    },
