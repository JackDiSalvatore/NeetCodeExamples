    {
      "id": "KTLSJU1Qx7ZoEQMpV-FjU",
      "type": "text",
      "x": 284.4231839177944,
      "y": -253.21576965005158,
      "width": 875.0072021484375,
      "height": 172.8,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
