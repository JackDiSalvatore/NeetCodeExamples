      "boundElements": [],
      "updated": 1730469474555,
      "link": null,
      "locked": false,
      "text": "\"Dummy\" node approach: We use a \"dummy\" head node to always be \"in front\" of the real head, so we always have a \"previous\"\nnode pointer to perform operations such as deletion of the head.\n[NOTE: this is only beneficial for iterative approaches]",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Dummy\" node approach: We use a \"dummy\" head node to always be \"in front\" of the real head, so we always have a \"previous\"\nnode pointer to perform operations such as deletion of the head.\n[NOTE: this is only beneficial for iterative approaches]",
      "autoResize": true,
      "lineHeight": 1.35
    },
